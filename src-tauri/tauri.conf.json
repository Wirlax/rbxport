{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rekordbox-lite",
  "version": "0.1.0",
  "identifier": "com.chrisle.rekordbox-lite",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "rekordbox-lite",
        "width": 1800,
        "height": 1130,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Rekordbox export mode",
    "longDescription": "Manage a Rekordbox library, analyze tracks, write USB exports, and serve the library to CDJs over Pro DJ Link.",
    "copyright": "Chris Le",
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
