{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the Preferences window",
  "windows": [
    "main",
    "preferences"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:default",
    "opener:default"
  ]
}
